# ================================================
# WhatsApp Marketing Platform — Environment Config
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ================================================

# --- Database (Docker service name as host) ---
DATABASE_URL=postgresql+asyncpg://wa:wa@postgres:5432/wa_marketing

# --- Redis (Docker service name as host) ---
REDIS_URL=redis://redis:6379/0

# --- WhatsApp (Meta Cloud API) ---
# Get from: Meta Developer Console > Your App > WhatsApp > API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Webhook Verification ---
# Any secret string you choose. Must match exactly what you enter in Meta's console.
WEBHOOK_VERIFY_TOKEN=change_me_to_a_long_secret_string

# --- AI (Anthropic Claude) ---
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Development Flags ---
# true = skip real WhatsApp API calls, log to console instead (safe for local dev)
MOCK_WHATSAPP=true

# --- Frontend ---
# URL of the backend AS SEEN FROM THE BROWSER.
# In local dev this is always localhost (the host-mapped port), not the Docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
